# Execution mode: paper | dry | live
POLY_MODE=paper

# Phase 2 dry-run (read-only — no keys needed)
DRY_POLL_SECONDS=5
DRY_ASSETS=BTC,ETH,SOL,BNB,XRP

# --- Markov strategy (5-min crypto up/down style markets) ---
# Minimum edge (model prob minus market price) to consider a trade
MIN_EDGE=0.03
# Only trade when market price is inside this band (cents, 0-1 scale)
ENTRY_MIN_PRICE=0.83
ENTRY_MAX_PRICE=0.97
# Fraction of full Kelly to bet (0.25 = quarter-Kelly, safer for beginners)
KELLY_FRACTION=0.25
# Cap any single bet as fraction of bankroll
MAX_BET_FRACTION=0.10
STARTING_BANKROLL=1000

# --- Cross-market arb (Phase 2 — not used in paper v0.1) ---
MIN_ARB_EDGE_BPS=50
MATCH_AUTO_THRESHOLD=0.85

# --- Live mode only (never commit real keys) ---
# POLYGON_PRIVATE_KEY=
# KALSHI_API_KEY=
# KALSHI_API_SECRET=
